# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated by `next dev`
AGENTS.md

# licensed web fonts are installed at build time (see scripts/prepare-fonts.mjs)
/public/fonts/*.woff2
/public/fonts/*.woff
/public/fonts/*.ttf
/public/fonts/*.otf
/public/fonts/*.txt
/public/fonts/*.md
!/public/fonts/README.md

# licensed font bundle stays out of the public repository (delivered via build environment)
/assets/
